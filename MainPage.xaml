<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             x:Name="Root"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Paranova.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="Auto,*">

        <!-- Menu latéral. Replié : seules les icônes restent visibles. -->
        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                WidthRequest="238"
                Padding="16,22"
                BackgroundColor="{StaticResource Sidebar}"
                StrokeThickness="0">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="24">
                <HorizontalStackLayout Spacing="11" VerticalOptions="Center">
                    <Border WidthRequest="42"
                            HeightRequest="42"
                            Padding="0"
                            BackgroundColor="White"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="✚"
                               TextColor="{StaticResource Primary}"
                               FontSize="23"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="0"
                                         VerticalOptions="Center"
                                         IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}">
                        <Label Text="PARANOVA" TextColor="White" FontSize="19" FontAttributes="Bold" />
                        <Label Text="Gestion de pharmacie" TextColor="#A7F3D0" FontSize="10" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout x:Name="MenuList" Spacing="6">
                        <Label Text="MENU PRINCIPAL" Margin="12,4,0,4" TextColor="#6EE7B7" FontSize="10" FontAttributes="Bold"
                               IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />

                        <Border Style="{StaticResource MenuItem}" BackgroundColor="#0F766E">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" CommandParameter="dashboard" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="▦" Style="{StaticResource MenuIcon}" />
                                <Label Text="Tableau de bord" Style="{StaticResource MenuText}" IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource MenuItem}">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" CommandParameter="ventes" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="🛒" Style="{StaticResource MenuIcon}" />
                                <Label Text="Ventes &amp; Comptoir" Style="{StaticResource MenuText}" IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource MenuItem}">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" CommandParameter="Ordonnances" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="▤" Style="{StaticResource MenuIcon}" />
                                <Label Text="Ordonnances" Style="{StaticResource MenuText}" IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Text="ACHATS &amp; STOCKS" Margin="12,18,0,4" TextColor="#6EE7B7" FontSize="10" FontAttributes="Bold"
                               IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                        <Border Style="{StaticResource MenuItem}">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" CommandParameter="Achats &amp; Réceptions" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="↓" Style="{StaticResource MenuIcon}" />
                                <Label Text="Achats &amp; Réceptions" Style="{StaticResource MenuText}" IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource MenuItem}">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" CommandParameter="État du stock" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="▣" Style="{StaticResource MenuIcon}" />
                                <Label Text="État du stock" Style="{StaticResource MenuText}" IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource MenuItem}">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" CommandParameter="Inventaire" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="✓" Style="{StaticResource MenuIcon}" />
                                <Label Text="Inventaire" Style="{StaticResource MenuText}" IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Text="CATALOGUE &amp; TIERS" Margin="12,18,0,4" TextColor="#6EE7B7" FontSize="10" FontAttributes="Bold"
                               IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                        <Border Style="{StaticResource MenuItem}">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" CommandParameter="Articles &amp; Produits" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="●" Style="{StaticResource MenuIcon}" />
                                <Label Text="Articles &amp; Produits" Style="{StaticResource MenuText}" IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource MenuItem}">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" CommandParameter="Fournisseurs" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="♙" Style="{StaticResource MenuIcon}" />
                                <Label Text="Fournisseurs" Style="{StaticResource MenuText}" IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource MenuItem}">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" CommandParameter="Patients &amp; AMO" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="♟" Style="{StaticResource MenuIcon}" />
                                <Label Text="Patients &amp; AMO" Style="{StaticResource MenuText}" IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2"
                        Padding="6"
                        BackgroundColor="#065F46"
                        Stroke="#047857">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="10">
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                Padding="0"
                                BackgroundColor="#10B981"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17" />
                            </Border.StrokeShape>
                            <Label Text="AD"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="0"
                                             VerticalOptions="Center"
                                             IsVisible="{Binding IsSidebarExpanded, Source={x:Reference Root}}">
                            <Label Text="Administrateur" TextColor="White" FontSize="12" FontAttributes="Bold" />
                            <Label Text="Session active" TextColor="#A7F3D0" FontSize="10" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Zone principale : barre du haut + page affichée. -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" BackgroundColor="{StaticResource PageBackground}">
            <Border Grid.Row="0"
                    Padding="20,12"
                    BackgroundColor="White"
                    Stroke="{StaticResource Line}"
                    StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <!-- Bouton pour replier / déplier le menu latéral. -->
                    <Button x:Name="CollapseButton"
                            Text="«"
                            Clicked="OnCollapseClicked"
                            ToolTipProperties.Text="Replier le menu"
                            WidthRequest="42"
                            HeightRequest="42"
                            Padding="0"
                            FontSize="20"
                            FontAttributes="Bold"
                            BackgroundColor="#ECFDF5"
                            TextColor="{StaticResource Primary}"
                            CornerRadius="11" />

                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="PageTitle"
                               Text="Tableau de bord"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="21"
                               FontAttributes="Bold" />
                        <Label x:Name="PageSubtitle"
                               Text="Situation financière et activité de la pharmacie"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="11" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="0" HorizontalOptions="End">
                            <Label Text="09:42" TextColor="{StaticResource TextPrimary}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Text="Lundi 5 octobre 2026" TextColor="{StaticResource TextMuted}" FontSize="10" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                        <Button Text="☼"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                FontSize="18"
                                BackgroundColor="#F1F5F9"
                                TextColor="{StaticResource TextPrimary}"
                                CornerRadius="10" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- La page choisie dans le menu est placée ici (voir MainPage.xaml.cs). -->
            <ContentView x:Name="ContentHost" Grid.Row="1" />
        </Grid>
    </Grid>
</ContentPage>
